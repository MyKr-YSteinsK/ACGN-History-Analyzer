@baseUrl = http://localhost:8080

### 使用说明
# 1. 建议先运行 00-seed-data.http
# 2. 先预览，再正式导入
# 3. 当前 subject 导入唯一性规则：
#    sourceId 相同则视为同一作品
# 4. 当前支持 franchiseName 自动匹配已有系列；匹配不到会按无系列作品导入

### 1. 预览导入
POST {{baseUrl}}/api/subjects/import/preview
Content-Type: application/json

{
  "subjects": [
    {
      "titleCn": "导入测试作品A",
      "subtitle": "Import A",
      "displayTitle": "导入测试作品A Import A",
      "releaseYear": 2026,
      "releaseQuarter": 1,
      "category": "ANIME",
      "studioName": "Import Studio",
      "platformLink": "https://example.com/import-a",
      "sourceId": "import-http-a",
      "status": "NORMAL"
    },
    {
      "titleCn": "导入测试作品B",
      "subtitle": "Import B",
      "displayTitle": "导入测试作品B Import B",
      "franchiseName": "进击的巨人",
      "seasonIndex": 5,
      "partIndex": 1,
      "releaseYear": 2026,
      "releaseQuarter": 2,
      "category": "ANIME",
      "studioName": "Import Studio",
      "platformLink": "https://example.com/import-b",
      "sourceId": "import-http-b",
      "status": "NORMAL"
    },
    {
      "titleCn": "进击的巨人",
      "subtitle": "The Final Season Part 1",
      "displayTitle": "进击的巨人 导入重复测试",
      "franchiseName": "进击的巨人",
      "seasonIndex": 4,
      "partIndex": 1,
      "releaseYear": 2031,
      "releaseQuarter": 2,
      "category": "ANIME",
      "studioName": "MAPPA",
      "platformLink": "https://example.com/import-duplicate-aot-p1",
      "sourceId": "400602",
      "status": "NORMAL"
    },
    {
      "titleCn": "蓝色监狱",
      "subtitle": null,
      "displayTitle": "蓝色监狱 小说版",
      "franchiseName": "蓝色监狱",
      "seasonIndex": null,
      "partIndex": null,
      "releaseYear": 2026,
      "releaseQuarter": 1,
      "category": "NOVEL",
      "studioName": "Test Publisher",
      "platformLink": "https://example.com/bluelock-novel",
      "sourceId": "import-http-bluelock-novel",
      "status": "NORMAL"
    },
    {
      "titleCn": "错误系列名称作品",
      "subtitle": null,
      "displayTitle": "错误系列名称作品",
      "franchiseName": "根本不存在的系列名",
      "releaseYear": 2026,
      "releaseQuarter": 4,
      "category": "ANIME",
      "studioName": "Import Studio",
      "platformLink": "https://example.com/import-bad-franchise",
      "sourceId": "import-http-bad-franchise",
      "status": "NORMAL"
    }
  ]
}

