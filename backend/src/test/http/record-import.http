@baseUrl = http://localhost:8080

### 使用说明
# 1. 在独立测试库中先运行 00-seed-data.http
# 2. 本文件会先创建两个“无记录的新作品”
# 3. 将作品 A 加入想看后预览，再正式导入

### 1. 创建记录导入专用作品A
POST {{baseUrl}}/api/subjects
Content-Type: application/json

{
  "titleCn": "记录导入专用作品A",
  "displayTitle": "记录导入专用作品A",
  "sourceId": "record-import-a",
  "releaseYear": 2026,
  "releaseQuarter": 1,
  "category": "ANIME",
  "studioName": "Import Record Studio",
  "platformLink": "https://example.com/record-import-a",
  "status": "NORMAL"
}
> {%
    client.global.set("record_import_subject_a_id", response.body.data.id);
%}

### 2. 创建记录导入专用作品B
POST {{baseUrl}}/api/subjects
Content-Type: application/json

{
  "titleCn": "记录导入专用作品B",
  "displayTitle": "记录导入专用作品B",
  "sourceId": "record-import-b",
  "releaseYear": 2026,
  "releaseQuarter": 2,
  "category": "COMIC",
  "studioName": "Import Record Studio",
  "platformLink": "https://example.com/record-import-b",
  "status": "NORMAL"
}

### 3. 将作品 A 加入想看
POST {{baseUrl}}/api/collections/want/{{record_import_subject_a_id}}

### 4. 预览批量导入记录
POST {{baseUrl}}/api/records/import/preview
Content-Type: application/json

{
  "records": [
    {
      "sourceId": "record-import-a",
      "scoreValue": 44,
      "recordYear": 2026,
      "recordQuarter": 1,
      "note": "记录导入成功样例A"
    },
    {
      "sourceId": "record-import-b",
      "scoreValue": 36,
      "recordYear": 2026,
      "recordQuarter": 2,
      "note": "记录导入成功样例B"
    },
    {
      "sourceId": "400602",
      "scoreValue": 48,
      "recordYear": 2024,
      "recordQuarter": 1,
      "note": "已存在记录，应覆盖更新"
    },
    {
      "sourceId": "record-import-not-exist",
      "recordYear": 2026,
      "recordQuarter": 3,
      "note": "作品不存在，应跳过"
    }
  ]
}

### 5. 正式批量导入记录
POST {{baseUrl}}/api/records/import
Content-Type: application/json

{
  "records": [
    {
      "sourceId": "record-import-a",
      "scoreValue": 44,
      "recordYear": 2026,
      "recordQuarter": 1,
      "note": "记录导入成功样例A"
    },
    {
      "sourceId": "record-import-b",
      "scoreValue": 36,
      "recordYear": 2026,
      "recordQuarter": 2,
      "note": "记录导入成功样例B"
    },
    {
      "sourceId": "400602",
      "scoreValue": 48,
      "recordYear": 2024,
      "recordQuarter": 1,
      "note": "已存在记录，应覆盖更新"
    },
    {
      "sourceId": "record-import-not-exist",
      "recordYear": 2026,
      "recordQuarter": 3,
      "note": "作品不存在，应跳过"
    }
  ]
}
> {%
    client.test("正式记录导入成功", function () {
        client.assert(response.status === 200 && response.body.code === 0);
        client.assert(response.body.data.importedCount === 3 && response.body.data.skippedCount === 1);
    });
%}

### 6. 确认正式导入移除了作品 A 的想看状态
GET {{baseUrl}}/api/collections?type=WANT&size=100

> {%
    client.test("正式记录所属作品退出想看", function () {
        const subjectId = Number(client.global.get("record_import_subject_a_id"));
        client.assert(response.body.data.content.every(item => item.subjectId !== subjectId));
    });
%}

### 7. 查询 2026 年记录
GET {{baseUrl}}/api/records?year=2026
